# Optional Node-side research. Leave URL unset: planner disabled, deterministic path.
# Use a dedicated >=32-character secret, never a worker/Blob/production secret.
RND_PLANNER_URL=
RND_PLANNER_TOKEN=
# Local contract evaluation only; production uses HTTPS and denies redirects.
RND_PLANNER_ALLOW_LOOPBACK=0
# May lower the persisted job budget; values above five are rejected.
RND_MAX_GENERATION_ATTEMPTS=5
# Existing Node-side optional memory; never forward these to the planner runtime.
HINDSIGHT_API_URL=
HINDSIGHT_API_KEY=
HINDSIGHT_RND_BANK=draftmyhair-rnd
