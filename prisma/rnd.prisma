enum RnDCampaignStatus {
  DRAFT
  RUNNING
  PAUSED
  COMPLETED
  CANCELLED
}

enum RnDTargetType {
  SINGLE
  COMPOSITE
  PARALLEL
}

enum RnDTargetStatus {
  DRAFT
  QUEUED
  PROCESSING
  QA
  HUMAN_APPROVAL
  APPROVED
  REJECTED
  EXHAUSTED
  FAILED
}

enum RnDAssetKind {
  SOURCE
  GENERATED
}

enum RnDJobStatus {
  QUEUED
  PROCESSING
  QA
  HUMAN_APPROVAL
  COMPLETED
  REFINING
  EXHAUSTED
  FAILED
  CANCELLED
}

enum RnDAttemptVerdict {
  REFINE
  HUMAN_APPROVAL
  APPROVED
  EXHAUSTED
  FAILED
}

model RnDCampaign {
  id                  String            @id @default(cuid())
  name                String
  status              RnDCampaignStatus @default(DRAFT)
  autoAdvanceEnabled  Boolean           @default(false)
  createdByUserId     String
  createdAt            DateTime          @default(now())
  updatedAt            DateTime          @updatedAt
  targets              RnDTarget[]

  @@index([status])
  @@index([createdByUserId])
  @@index([createdAt])
}

model RnDTarget {
  id                  String          @id @default(cuid())
  campaignId          String
  targetType          RnDTargetType
  targetKey           String
  hairstyleId         String?
  hairColorKey        String?
  beardKey            String?
  hardCoreInstruction String?         @db.Text
  sourceAssetId       String
  currentJobId        String?
  status              RnDTargetStatus @default(DRAFT)
  createdAt           DateTime        @default(now())
  updatedAt           DateTime        @updatedAt
  campaign            RnDCampaign    @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  sourceAsset         RnDAsset        @relation(fields: [sourceAssetId], references: [id])
  jobs                RnDJob[]

  @@unique([campaignId, targetKey])
  @@index([campaignId, status])
  @@index([sourceAssetId])
  @@index([status])
}

model RnDAsset {
  id                    String          @id @default(cuid())
  kind                  RnDAssetKind
  storageKey            String          @unique
  blobUrl               String          @unique
  originalFilename      String?
  mimeType              String
  fileSize              Int
  width                 Int?
  height                Int?
  checksum              String?
  immutable             Boolean         @default(true)
  createdAt             DateTime        @default(now())
  sourceForTargets      RnDTarget[]
  generatedForAttempts  RnDAttempt[]

  @@index([kind])
  @@index([createdAt])
}

model RnDJob {
  id                  String       @id @default(cuid())
  targetId            String
  status              RnDJobStatus @default(QUEUED)
  promptVersionNumber Int          @default(1)
  currentPrompt       String       @db.Text
  attemptCount        Int          @default(0)
  leaseOwner          String?
  leaseExpiresAt      DateTime?
  heartbeatAt         DateTime?
  queuedAt            DateTime     @default(now())
  startedAt           DateTime?
  completedAt         DateTime?
  updatedAt            DateTime     @updatedAt
  failureCode         String?
  failureMessage      String?      @db.Text
  target              RnDTarget    @relation(fields: [targetId], references: [id], onDelete: Cascade)
  attempts            RnDAttempt[]

  @@index([targetId, status])
  @@index([status, queuedAt])
  @@index([leaseExpiresAt])
  @@index([leaseOwner])
}

model RnDAttempt {
  id                    String            @id @default(cuid())
  jobId                 String
  attemptNumber         Int
  prompt                String            @db.Text
  promptRevision        String
  submittedAt           DateTime
  generationStartedAt   DateTime?
  generationCompletedAt DateTime?
  artifactId            String?
  qaJson                Json?
  overallScore          Decimal?          @db.Decimal(4, 2)
  aiGatePassed          Boolean?
  publicationTierPassed Boolean?
  verdict               RnDAttemptVerdict
  refinementSlot        String?
  refinementReason      String?           @db.Text
  errorCode             String?
  errorMessage          String?           @db.Text
  job                   RnDJob            @relation(fields: [jobId], references: [id], onDelete: Cascade)
  artifact              RnDAsset?         @relation(fields: [artifactId], references: [id], onDelete: Restrict)

  @@unique([jobId, attemptNumber])
  @@index([jobId, submittedAt])
  @@index([verdict])
  @@index([aiGatePassed])
  @@index([publicationTierPassed])
}
