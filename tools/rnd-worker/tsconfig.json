{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "noEmit": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowImportingTsExtensions": true,
    "types": ["node"]
  },
  "include": [
    "worker.ts",
    "gemini-page.ts",
    "artifact-integrity.ts",
    "profile-manager.ts",
    "vercel-bypass.ts",
    "link-gemini-profiles.ts",
    "enqueue-test.ts",
    "requeue.ts",
    "status.ts"
  ],
  "exclude": ["node_modules"]
}
