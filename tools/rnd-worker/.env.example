# Draft My Hair R&D local Windows worker
# Copy this file to .env and fill the required secrets locally.
# Never commit the real .env file.

RND_API_BASE_URL=https://draftmyhair-git-rnd-local-gemini-worker-v1-draftmyhair.vercel.app
RND_WORKER_TOKEN=
CHROME_PATH=C:\Program Files\Google\Chrome\Application\chrome.exe

# Gemini profile registry. If omitted, the worker falls back to the legacy
# single-profile directory below.
# RND_GEMINI_PROFILES_FILE=tools/rnd-worker/profiles.json

# Local profile state. Do not commit this file.
# RND_GEMINI_PROFILE_STATE_FILE=tools/rnd-worker/profile-state.json

# Conservative per-profile limits. These are worker-side guards.
RND_PROFILE_HOURLY_LIMIT=30
RND_PROFILE_MIN_INTERVAL_MS=120000
RND_PROFILE_COOLDOWN_MS=3600000

# Legacy single-profile fallback:
# RND_GEMINI_PROFILE_DIR=C:\path\to\persistent\chrome-profile

# Optional output/state locations:
# DMH_RND_OUTPUT_DIR=C:\path\to\rnd-worker-output
# RND_WORKER_ID_FILE=C:\path\to\.rnd-worker-id

# Required when the Preview deployment is protected by Vercel Authentication:
# VERCEL_AUTOMATION_BYPASS_SECRET=
